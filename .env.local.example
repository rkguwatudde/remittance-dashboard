# Remittance admin dashboard — copy to .env.local (gitignored)

# --- Local Nest (direct) ---
# NEXT_PUBLIC_REMITTANCE_API_URL=http://localhost:9002

# --- Production (Vercel Production / main) — same-origin proxy ---
# REMITTANCE_API_UPSTREAM=https://remittance.api.borabond.com
# NEXT_PUBLIC_REMITTANCE_API_URL=/api/remittance-backend

# --- Staging sandbox (Vercel Preview / dev, or npm run dev:sandbox) ---
REMITTANCE_API_UPSTREAM=https://staging-remittance.borabond.com
NEXT_PUBLIC_REMITTANCE_API_URL=/api/remittance-backend

# Direct cross-origin (only if API has a single CORS layer and origin allowlisted)
# NEXT_PUBLIC_REMITTANCE_API_URL=https://staging-remittance.borabond.com
