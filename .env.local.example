# Remittance API (Nest) — see remittance/src/main.ts CORS allowlist for direct calls.
#
# Local: direct to Nest
# NEXT_PUBLIC_REMITTANCE_API_URL=http://localhost:9002
#
# Production: same-origin proxy (avoids browser CORS when CDN/nginx duplicate Access-Control-*)
# REMITTANCE_API_UPSTREAM=https://remittance.api.borabond.com
# NEXT_PUBLIC_REMITTANCE_API_URL=/api/remittance-backend
#
# Production (direct cross-origin — only if a single CORS layer on the API)
# NEXT_PUBLIC_REMITTANCE_API_URL=https://remittance.api.borabond.com